# Pass with -config, or set any of these as environment variables (which win).
# Every setting is optional.

# SparkRoot: snapshots are read from its Projects/ folder, settings live in
# its Config/ folder (created with defaults if missing). Defaults to the
# folder the web binary sits in.
# SPARK_ROOT=~/Documents/Spark

# Listen address. Defaults to 127.0.0.1:8080.
# SPARK_ADDR=127.0.0.1:8080

# Mode: local (the default) or remote, a team server that local deployments
# push to. Remote needs the login below; it is the first admin.
# SPARK_MODE=local

# The address people open, with no path. Strongly recommended for a remote
# that faces the Internet: Spark then answers only to this host name, and
# takes invite links, the Secure cookie flag and HSTS from it.
# SPARK_URL=https://spark.example.com

# Local only: answer to any host name, not just localhost. Turn login on too.
# SPARK_ALLOW_NETWORK=false

# Your HTTPS proxy's addresses or ranges, comma separated. X-Forwarded-For and
# X-Forwarded-Proto are believed only from these.
# SPARK_TRUSTED_PROXIES=127.0.0.1

# Login. Leave both unset to turn login off. If the page is reachable from
# the Internet, set them, and use a long password.
# SPARK_USERNAME=terry
# SPARK_PASSWORD=at-least-fifteen-characters

# Shortest password allowed (default 15, at most 72 bytes).
# SPARK_MIN_PASSWORD_LENGTH=15

# Failed logins per account: the first 4 wait 2 s each, then 30 s, then 1,
# 2, 4, 8, 16, 32 min. The 11th locks until `web unlock <username>`.
# SPARK_PENALTY_START=4
# SPARK_LOCKOUT_AFTER=11
# SPARK_LOCKOUT=on
