# Install (user units, no root needed):
#   install -Dm755 ../collector ~/.local/bin/spark-collector
#   install -Dm644 spark-collector.service spark-collector.timer -t ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now spark-collector.timer
#
# Logs: journalctl --user -u spark-collector

[Unit]
Description=Run the Spark collector every 15 minutes

[Timer]
OnCalendar=*:0/15
Persistent=true

[Install]
WantedBy=timers.target
