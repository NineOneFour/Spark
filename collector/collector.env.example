# Copy to ~/.config/spark/collector.env and fill in.
# Any of these can also be set as environment variables, which win over this file.

# Unique per machine. Must not contain "__". Defaults to "local".
MACHINE_ID=work-laptop

# Folders scanned recursively for spark.md files. Comma-separate several.
SCAN_ROOT=~/Projects

# Where snapshots go. Pick one:
#
# 1. A local folder (localhost setups). Defaults to a projects/ folder
#    next to the collector binary, which is where the web app looks too.
# TARGET_DIR=~/spark/projects
#
# 2. The Samba share on a central Spark server. Setting SMB_HOST selects this.
# SMB_HOST=spark.lan
# SMB_SHARE=projects
# SMB_USER=spark
# SMB_PASSWORD=change-me
