# Copy to ~/.config/spark/collector.env and fill in.

# Unique per machine. Must not contain "__".
MACHINE_ID=work-laptop

# Folder scanned recursively for spark.md files.
SCAN_ROOT=~/Projects

# Samba share on the Spark server (port defaults to 445).
SMB_HOST=spark.lan
SMB_SHARE=projects
SMB_USER=spark
SMB_PASSWORD=change-me
